---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import Section from '../components/layout/Section.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import IconLink from '../components/ui/IconLink.astro';
import { site } from '../content/site';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  headline: 'KubePreflight releases',
  description:
    'KubePreflight release history, including the current v1.3.1 certification-driven redaction and RBAC hardening patch.',
  url: `${site.url}/releases`
};
---

<BaseLayout
  title="Releases"
  description="KubePreflight release history, current install version, and conservative patch-release claims."
  structuredData={structuredData}
>
  <Section tone="ink" spacing="md">
    <Container>
      <a href="/" class="text-sm text-text-muted hover:text-text-primary transition-colors duration-150">
        ← Back to home
      </a>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <Badge tone="signal">Latest release: {site.latestReleaseVersion}</Badge>
        <Badge tone="neutral">Certification-driven redaction and RBAC hardening</Badge>
      </div>

      <h1 class="mt-5 max-w-3xl font-editorial text-4xl leading-[1.12] text-text-primary sm:text-5xl">
        KubePreflight releases.
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-text-muted">
        v1.3.1 is a separate patch release, not a retroactive edit to v1.3.0. Existing users should
        move to the safer patch when they want the redaction and documented RBAC certification fixes.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
        <Button href={site.latestReleaseUrl} external>View {site.latestReleaseVersion} release</Button>
        <IconLink href="/install">Install current version</IconLink>
      </div>
    </Container>
  </Section>

  <Section tone="ink-raised">
    <Container>
      <div class="max-w-2xl">
        <span class="font-mono text-xs uppercase tracking-wide text-text-muted">Release history</span>
        <h2 class="mt-3 font-editorial text-3xl text-text-primary sm:text-4xl">
          Current patch and historical feature release.
        </h2>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-2">
        {
          site.releaseHistory.map((release) => (
            <article class="rounded-[var(--radius-md)] border border-border bg-ink-950 p-6">
              <div class="flex flex-wrap items-center gap-3">
                <Badge tone={release.current ? 'signal' : 'neutral'}>{release.current ? 'Current' : 'Historical'}</Badge>
                <span class="font-mono text-sm text-text-muted">{release.version}</span>
              </div>

              <h3 class="mt-4 font-editorial text-2xl leading-tight text-text-primary">
                {release.version} — {release.title}
              </h3>

              <p class="mt-4 text-sm leading-relaxed text-text-muted">{release.summary}</p>

              <ul class="mt-6 flex flex-col gap-3">
                {release.highlights.map((item) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-text-primary">
                    <span class="mt-0.5 text-signal" aria-hidden="true">
                      ✓
                    </span>
                    {item}
                  </li>
                ))}
              </ul>

              <p class="mt-6 text-sm leading-relaxed text-text-muted">{release.verification}</p>

              {release.readOnlyClaim && (
                <p class="mt-3 text-sm leading-relaxed text-text-muted">{release.readOnlyClaim}</p>
              )}

              <div class="mt-6">
                <IconLink href={release.url} icon="external" external>
                  View GitHub release
                </IconLink>
              </div>
            </article>
          ))
        }
      </div>
    </Container>
  </Section>
</BaseLayout>
