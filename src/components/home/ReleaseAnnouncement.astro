---
import fs from 'node:fs';
import path from 'node:path';
import Container from '../layout/Container.astro';
import Section from '../layout/Section.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import IconLink from '../ui/IconLink.astro';
import { site } from '../../content/site';

// Patch releases do not always ship fresh media. Until matching files land
// in public/media/, this section renders text-only with no public placeholder.
// Media appears automatically on the next build once both files exist.
const demoVideoPath = `/media/kubepreflight-${site.latestReleaseVersion}-evaluation-coverage.mp4`;
const demoPosterPath = `/media/kubepreflight-${site.latestReleaseVersion}-evaluation-coverage-poster.png`;
const hasReleaseMedia =
  fs.existsSync(path.join(process.cwd(), 'public', demoVideoPath.slice(1))) &&
  fs.existsSync(path.join(process.cwd(), 'public', demoPosterPath.slice(1)));
---

<Section tone="ink-raised">
  <Container>
    <div class={hasReleaseMedia ? 'grid grid-cols-1 gap-12 lg:grid-cols-12' : 'max-w-2xl'}>
      <div class={hasReleaseMedia ? 'lg:col-span-5' : ''}>
        <div class="flex flex-wrap items-center gap-3">
          <Badge tone="signal">New release</Badge>
          <Badge tone="neutral">{site.latestReleaseVersion}</Badge>
        </div>

        <h2 class="mt-4 font-editorial text-3xl leading-[1.15] text-text-primary sm:text-4xl">
          KubePreflight {site.latestReleaseVersion}
        </h2>

        <p class="mt-4 leading-relaxed text-text-muted">
          {site.latestReleaseSummary}
        </p>

        <ul class="mt-6 flex flex-col gap-3">
          {
            site.latestReleaseHighlights.map((item) => (
              <li class="flex gap-3 text-sm leading-relaxed text-text-primary">
                <span class="mt-0.5 text-signal" aria-hidden="true">
                  ✓
                </span>
                {item}
              </li>
            ))
          }
        </ul>

        <p class="mt-6 text-sm leading-relaxed text-text-muted">
          {site.latestReleaseVerification}
        </p>

        <p class="mt-3 text-sm leading-relaxed text-text-muted">
          {site.readOnlyReleaseClaim}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
          <Button href={site.latestReleaseUrl} external>View {site.latestReleaseVersion} release</Button>
          <IconLink href="/releases">Release history</IconLink>
        </div>
      </div>

      {
        hasReleaseMedia && (
          <div class="lg:col-span-7">
            <figure>
              <div class="demo-video-frame aspect-video overflow-hidden rounded-[var(--radius-md)] border border-border bg-ink-900">
                <video
                  class="h-full w-full object-contain"
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  poster={demoPosterPath}
                  aria-label={`KubePreflight ${site.latestReleaseVersion} evaluation coverage demo`}
                >
                  <source src={demoVideoPath} type="video/mp4" />
                </video>
              </div>
              <img
                src={demoPosterPath}
                alt={`KubePreflight ${site.latestReleaseVersion} evaluation coverage — static preview for reduced-motion viewing`}
                loading="lazy"
                decoding="async"
                width="1100"
                height="619"
                class="demo-static-fallback aspect-video w-full rounded-[var(--radius-md)] border border-border object-contain"
              />
              <figcaption class="mt-3 text-sm leading-relaxed text-text-muted">
                Evaluation coverage rendered end to end: which rules ran, which were skipped by scan
                mode, and how that changes the overall decision.
              </figcaption>
            </figure>
          </div>
        )
      }
    </div>
  </Container>
</Section>

<style>
  .demo-static-fallback {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .demo-video-frame {
      display: none;
    }

    .demo-static-fallback {
      display: block;
    }
  }
</style>
